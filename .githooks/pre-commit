#!/usr/bin/env sh
set -eu

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File ./scripts/Test-PublicBoundary.ps1 -Staged
fi

if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Test-PublicBoundary.ps1 -Staged
fi

echo "PowerShell is required to run the public boundary check." >&2
exit 1
